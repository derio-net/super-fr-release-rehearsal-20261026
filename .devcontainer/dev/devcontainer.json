{
  "name": "super-fr \u2014 dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "postCreateCommand": "bash .devcontainer/dev/bootstrap.sh",
  "runArgs": [
    "--env-file",
    "${localEnv:HOME}/.config/fr/secrets/super-fr/dev.env"
  ],
  "containerEnv": {
    "PATH": "/home/vscode/.local/share/fr/closeout-1206-runtime-py314/bin:/home/vscode/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.local/share/fr/closeout-1206-runtime-py314",
    "UV_PYTHON": "3.14.10",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_FROZEN": "1",
    "UV_NO_BUILD": "1",
    "UV_CONCURRENT_BUILDS": "1",
    "UV_CONCURRENT_INSTALLS": "1",
    "UV_CONCURRENT_DOWNLOADS": "1",
    "UV_HTTP_RETRIES": "0"
  },
  "customizations": {
    "fr": {
      "profile": "dev",
      "purpose": "day-to-day development: uv run pytest -q --no-cov, ruff, mypy"
    }
  }
}
